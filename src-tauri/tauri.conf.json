{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Life OS",
  "version": "0.1.0",
  "identifier": "com.fzc.my-life-os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
   "windows": [
      {
        "title": "My Life OS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
       "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
"scope": ["C:/Users/lenovo/Documents/MyLifeOS-Workspace/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
